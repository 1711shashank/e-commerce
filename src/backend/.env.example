
REDIS_URL
REDIS_PORT
TZ
JWT_SECRET_KEY
JWT_ALGORITHM
JWT_ACCESS_TOKEN_LIFETIME_MINUTES
JWT_REFRESH_TOKEN_LIFETIME_DAYS
NGINX_PORT

# Default catalog portal admin (seeded on auth-service / catalog-service start)
ADMIN_EMAIL
ADMIN_PASSWORD
ADMIN_USERNAME
STAFF_EMAIL
STAFF_PASSWORD

# --- Auth Service ---
# Local: AUTH_DEBUG=True and any AUTH_SECRET_KEY. Production: AUTH_DEBUG=False
# and a strong unique AUTH_SECRET_KEY (never "dev-auth-secret").
AUTH_SECRET_KEY
AUTH_DEBUG
AUTH_ALLOWED_HOSTS
AUTH_DB_NAME
AUTH_DB_USER
AUTH_DB_PASSWORD
AUTH_DB_HOST
AUTH_DB_PORT
AUTH_SERVICE_PORT

# Password reset email
# Local dev — prints reset links to auth-service logs:
# Production — AWS SES (sender/domain must be verified in SES):
AUTH_EMAIL_BACKEND

# AWS SES configuration
AWS_SES_REGION_NAME
AWS_SES_USE_V2
AWS_SES_AUTO_THROTTLE
AWS_SES_CONFIGURATION_SET

# Reuses AWS credentials below (or IAM role on ECS — leave keys empty)
AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY

AUTH_DEFAULT_FROM_EMAIL
AUTH_PASSWORD_RESET_URL
AUTH_PASSWORD_RESET_TOKEN_LIFETIME_MINUTES
AUTH_EMAIL_VERIFICATION_OTP_LIFETIME_MINUTES
AUTH_EMAIL_VERIFICATION_OTP_LENGTH
AUTH_LOGIN_RATE_PER_MINUTE
AUTH_REGISTER_RATE_PER_MINUTE
# Default 30 — max refresh requests per IP per minute
AUTH_TOKEN_REFRESH_RATE_PER_MINUTE
# Default False — leave False when TLS terminates at nginx/ALB
AUTH_SECURE_SSL_REDIRECT
# Default 31536000 (1 year); only applied when AUTH_DEBUG=False
AUTH_SECURE_HSTS_SECONDS

PASSWORD_RESET_REQUEST_RATE_PER_MINUTE
PASSWORD_RESET_CONFIRM_RATE_PER_MINUTE
EMAIL_VERIFICATION_VERIFY_RATE_PER_MINUTE
EMAIL_VERIFICATION_RESEND_RATE_PER_MINUTE

# Optional SMTP fallback (only if AUTH_EMAIL_BACKEND is smtp backend):
AUTH_EMAIL_HOST
AUTH_EMAIL_PORT
AUTH_EMAIL_USE_TLS
AUTH_EMAIL_HOST_USER
AUTH_EMAIL_HOST_PASSWORD

# --- Catalog Service ---
CATALOG_SECRET_KEY
CATALOG_DEBUG
CATALOG_ALLOWED_HOSTS
CATALOG_DB_NAME
CATALOG_DB_USER
CATALOG_DB_PASSWORD
CATALOG_DB_HOST
CATALOG_DB_PORT
CATALOG_SERVICE_PORT
