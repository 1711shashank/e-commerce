# =============================================================================
# Django backend / infra — Environment Variables
# Copy to .env and fill in real values for local development.
#   cp src/backend/.env.example src/backend/.env
# Docker Compose loads this file via: --env-file src/backend/.env
# =============================================================================

# --- Shared ---
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
NGINX_PORT=80

# Default catalog portal admin (seeded on auth-service start)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin
STAFF_EMAIL=staff@aurelia.example
STAFF_PASSWORD=StaffPass123!
# --- Auth Service ---
AUTH_SECRET_KEY=change-me-auth-django-secret
AUTH_DEBUG=True
AUTH_ALLOWED_HOSTS=localhost,127.0.0.1,auth-service,admin.localhost,www.localhost
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password
AUTH_DB_HOST=auth_db
AUTH_DB_PORT=5432
AUTH_SERVICE_PORT=8001

# --- Catalog Service ---
CATALOG_SECRET_KEY=change-me-catalog-django-secret
CATALOG_DEBUG=True
CATALOG_ALLOWED_HOSTS=localhost,127.0.0.1,catalog-service,admin.localhost,www.localhost
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_password
CATALOG_DB_HOST=catalog_db
CATALOG_DB_PORT=5433
CATALOG_SERVICE_PORT=8002
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# --- Inventory Service ---
INVENTORY_SECRET_KEY=change-me-inventory-django-secret
INVENTORY_DEBUG=True
INVENTORY_ALLOWED_HOSTS=localhost,127.0.0.1,inventory-service
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_password
INVENTORY_DB_HOST=inventory_db
INVENTORY_DB_PORT=5434
INVENTORY_SERVICE_PORT=8003

# --- Order Service ---
ORDER_SECRET_KEY=change-me-order-django-secret
ORDER_DEBUG=True
ORDER_ALLOWED_HOSTS=localhost,127.0.0.1,order-service
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_password
ORDER_DB_HOST=order_db
ORDER_DB_PORT=5435
ORDER_SERVICE_PORT=8004

# --- Payment Service ---
PAYMENT_SECRET_KEY=change-me-payment-django-secret
PAYMENT_DEBUG=True
PAYMENT_ALLOWED_HOSTS=localhost,127.0.0.1,payment-service
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_password
PAYMENT_DB_HOST=payment_db
PAYMENT_DB_PORT=5436
PAYMENT_SERVICE_PORT=8005
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Notification Service ---
NOTIFICATION_SECRET_KEY=change-me-notification-django-secret
NOTIFICATION_DEBUG=True
NOTIFICATION_ALLOWED_HOSTS=localhost,127.0.0.1,notification-service
NOTIFICATION_SERVICE_PORT=8006
AWS_SES_REGION_NAME=ap-south-1
EMAIL_FROM=noreply@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
