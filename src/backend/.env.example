# =============================================================================
# Django backend / infra — Environment Variables
# Copy to .env and fill in real values for local development.
#   cp src/backend/.env.example src/backend/.env
# Docker Compose loads this file via: --env-file src/backend/.env
# =============================================================================

# --- Shared ---
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
TZ=Asia/Kolkata
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
NGINX_PORT=80

# Default catalog portal admin (seeded on auth-service start)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin
STAFF_EMAIL=staff@aurelia.example
STAFF_PASSWORD=StaffPass123!

# --- Auth Service ---
AUTH_SECRET_KEY=change-me-auth-django-secret
AUTH_DEBUG=True
AUTH_ALLOWED_HOSTS=localhost,127.0.0.1,auth-service,admin.localhost,www.localhost
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password
AUTH_DB_HOST=auth_db
AUTH_DB_PORT=5432
AUTH_SERVICE_PORT=8001

# Celery (auth-worker) — broker/result backend uses REDIS_URL above

# Email — AWS SES (password reset, transactional)
# Sender/domain must be verified in SES. In sandbox mode, recipient emails must also be verified.
AUTH_EMAIL_BACKEND=django_ses.SESBackend
AWS_SES_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=
AUTH_DEFAULT_FROM_EMAIL=noreply@yourdomain.com
AUTH_PASSWORD_RESET_URL=http://localhost:3000/reset-password
AUTH_PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30

# Local dev without AWS credentials — emails print in auth-worker logs:
# AUTH_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Optional SMTP fallback (only if AUTH_EMAIL_BACKEND is smtp backend):
AUTH_EMAIL_HOST=
AUTH_EMAIL_PORT=587
AUTH_EMAIL_USE_TLS=True
AUTH_EMAIL_HOST_USER=
AUTH_EMAIL_HOST_PASSWORD=

# --- Catalog Service ---
CATALOG_SECRET_KEY=change-me-catalog-django-secret
CATALOG_DEBUG=True
CATALOG_ALLOWED_HOSTS=localhost,127.0.0.1,catalog-service,admin.localhost,www.localhost
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_password
CATALOG_DB_HOST=catalog_db
CATALOG_DB_PORT=5433
CATALOG_SERVICE_PORT=8002
