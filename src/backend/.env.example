# =============================================================================
# Django backend / infra — Environment Variables
# Copy to .env and fill in real values for local development.
#   cp src/backend/.env.example src/backend/.env
# Docker Compose:
#   cp src/backend/.env.example src/backend/.env
#   docker compose --env-file src/backend/.env up
# auth-service and catalog-service also load src/backend/.env via env_file.
# =============================================================================

# --- Shared ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
NGINX_PORT=80

# Default catalog portal admin (seeded on auth-service / catalog-service start)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin
ADMIN_USERNAME=admin
STAFF_EMAIL=staff@aurelia.example
STAFF_PASSWORD=StaffPass123!

# --- Auth Service ---
AUTH_SECRET_KEY=change-me-auth-django-secret
AUTH_DEBUG=True
AUTH_ALLOWED_HOSTS=localhost,127.0.0.1,auth-service,admin.localhost,www.localhost
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password
AUTH_DB_HOST=auth_db
AUTH_DB_PORT=5432
AUTH_SERVICE_PORT=8001

# Password reset email
# Local dev — prints reset links to auth-service logs:
AUTH_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production — AWS SES (sender/domain must be verified in SES):
# AUTH_EMAIL_BACKEND=django_ses.SESBackend
AWS_SES_REGION_NAME=ap-south-1
# AWS_SES_REGION_ENDPOINT=email.ap-south-1.amazonaws.com
AWS_SES_USE_V2=True
AWS_SES_CONFIGURATION_SET=
# Reuses AWS credentials below (or IAM role on ECS — leave keys empty)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AUTH_DEFAULT_FROM_EMAIL=noreply@yourdomain.com
AUTH_PASSWORD_RESET_URL=http://localhost:3000/reset-password
AUTH_PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
PASSWORD_RESET_REQUEST_RATE=10/hour
PASSWORD_RESET_EMAIL_RATE=3/hour
PASSWORD_RESET_CONFIRM_RATE=20/hour

# --- Catalog Service ---
CATALOG_SECRET_KEY=change-me-catalog-django-secret
CATALOG_DEBUG=True
CATALOG_ALLOWED_HOSTS=localhost,127.0.0.1,catalog-service,admin.localhost,www.localhost
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_password
CATALOG_DB_HOST=catalog_db
CATALOG_DB_PORT=5433
CATALOG_SERVICE_PORT=8002
