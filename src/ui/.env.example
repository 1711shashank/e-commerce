# =============================================================================
# Next.js UI — Environment Variables
# Copy to .env.local for host `npm run dev`, or .env for Docker Compose.
#   cp src/ui/.env.example src/ui/.env.local
#   cp src/ui/.env.example src/ui/.env
# =============================================================================

# Host port mapped to the ui container
UI_PORT=3000

# Leave EMPTY for same-origin /api (required when using admin.localhost + localhost).
# Nginx proxies /api on both hosts. Do NOT set http://localhost here — that causes CORS
# when the staff portal on admin.localhost calls the store API origin.
# Local `npm run dev` without nginx: empty still works (Next.js rewrites /api → services).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_PATH=/api

# Public storefront origin (customers)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Staff portal origin (production: https://admin.yourdomain.com)
# Local easy mode: leave empty and open http://localhost:3000/admin
# Local host-split mode: http://admin.localhost:3000  (and set ADMIN_HOST below)
NEXT_PUBLIC_ADMIN_URL=

# Host-based split (optional). When set, middleware enforces store vs admin hosts.
# Example local split:
#   ADMIN_HOST=admin.localhost
#   STORE_HOSTS=localhost,127.0.0.1,www.localhost
#   NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3000
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Modern browsers resolve *.localhost → 127.0.0.1 (no /etc/hosts needed).
ADMIN_HOST=
STORE_HOSTS=localhost,127.0.0.1,www.localhost

# Server-side rewrite targets for `next dev` (not exposed to the browser)
AUTH_SERVICE_URL=http://127.0.0.1:8001
CATALOG_SERVICE_URL=http://127.0.0.1:8002
